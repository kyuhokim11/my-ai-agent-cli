{
    "name": "@jobbykim/ai-init",
    "version": "1.5.0-rc.1",
    "description": "어떤 프로젝트에서도 jobkim의 AI 개발 규칙과 스킬을 동일하게 적용하는 초기화 CLI",
    "main": "setup.js",
    "bin": {
        "ai-init": "setup.js"
    },
    "files": [
        "setup.js",
        "skill-sources.json",
        "skill-sources.lock.json",
        "lib/",
        "NOTICE",
        "LICENSE",
        "README.md",
        "rules/",
        "bundled-skills/"
    ],
    "scripts": {
        "test": "node --test",
        "prepublishOnly": "npm test && npm run validate:skills",
        "validate:skills": "node setup.js validate",
        "eval:list": "node scripts/evaluate.js",
        "eval:score": "node scripts/evaluate.js",
        "test:network": "node scripts/smoke-install.js",
        "verify:package": "node scripts/verify-package.js",
        "sources:update": "node scripts/update-source-lock.js"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "ai",
        "agent",
        "cli",
        "personal-agent",
        "claude",
        "codex",
        "gemini",
        "gpt",
        "llm",
        "openai",
        "personal-agent",
        "private-agent",
        "private-cli-agent"
    ],
    "author": "jobkim",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kyuhokim11/my-ai-agent-cli.git"
    },
    "homepage": "https://github.com/kyuhokim11/my-ai-agent-cli#readme",
    "bugs": {
        "url": "https://github.com/kyuhokim11/my-ai-agent-cli/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "yaml": "2.9.1"
    }
}
